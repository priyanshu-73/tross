# --- Service ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- API authentication (OPTIONAL) ------------------------------------------
# Empty = no authentication; anyone who can reach the service can call it.
# Set a comma-separated list of keys to require an `X-API-Key` header instead.
#
#   API_KEYS=$(python -c "import secrets; print(secrets.token_urlsafe(32))")
#
# Rate limiting applies either way, keyed by IP when there is no key.
API_KEYS=

# --- Data source ------------------------------------------------------------
# voyager          - LinkedIn's own Dash API. ALL fields. Default. Needs a session.
# public           - anonymous. NO credentials needed. No skills/certs, redaction-prone.
# embedded         - session; reads JSON inlined in the page. Top card only since
#                    LinkedIn's 2026 UI rewrite - prefer voyager.
# linkedin_scraper - Playwright + Chromium. Slowest; parser targets the old UI.
# proxycurl        - licensed third-party API. No LinkedIn account involved.
PROVIDER=voyager

# --- LinkedIn credentials ---------------------------------------------------
# Supply EITHER of these. Email + password is preferred: the service signs in
# itself, caches the session, and re-authenticates when LinkedIn expires it, so
# you never paste a cookie again.
#
# Use a throwaway account with 2FA DISABLED - automated sign-in cannot pass a
# 2FA challenge, and the service will not try to.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Fallback / 2FA-enabled accounts: paste the `li_at` cookie from a browser that
# is already signed in.  Required if automated login hits a checkpoint.
# DevTools > Application > Cookies > https://www.linkedin.com > li_at
# ('python scripts/login.py' fetches one for you.)
LINKEDIN_LI_AT=

# Where sessions are cached between restarts.  Both files hold live credentials
# and are gitignored.
SESSION_STATE_PATH=.session/storage_state.json
COOKIE_STORE_PATH=.session/cookies.json

# --- Optional outbound proxy (residential proxies reduce blocking) ----------
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Proxycurl provider (only needed when PROVIDER=proxycurl) --------------
PROXYCURL_API_KEY=

# --- Browser tuning (PROVIDER=linkedin_scraper only) ------------------------
HEADLESS=true
NAV_TIMEOUT_MS=45000
PAGE_SETTLE_MS=1200
FETCH_DETAIL_PAGES=true
MAX_CONCURRENT_SCRAPES=1
SCRAPE_MIN_INTERVAL_SECONDS=6

# --- Caching & rate limiting ------------------------------------------------
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=500
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
